#!/usr/bin/env python3
import argparse
import os
from pathlib import Path
import subprocess
import sys
import tempfile


def main():
    parser = argparse.ArgumentParser(prog="./conformance/baseline")
    parser.add_argument("scenario", nargs="?")
    args = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    command = ["cargo", "run", "--quiet", "--locked", "-p", "lyracore-conformance",
               "--example", "baseline", "--", "regenerate"]
    if args.scenario is None:
        os.chdir(root)
        os.execvp("cargo", command)

    scratch = Path(os.environ.get(
        "LYRACORE_CONFORMANCE_SCRATCH",
        Path.home() / ".cache/lyracore-scratch/conformance-run",
    ))
    scratch.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="baseline-", dir=scratch) as directory:
        result = Path(directory) / "result.json"
        environment = os.environ.copy()
        environment["TMPDIR"] = str(scratch)
        run = subprocess.run(
            [str(root / "conformance/run"), args.scenario, "--result", str(result)],
            cwd=root, env=environment, check=False,
        )
        if run.returncode not in (0, 1):
            return run.returncode
        if not result.is_file():
            return 2
        command.extend([args.scenario, str(result)])
        return subprocess.run(command, cwd=root, env=environment, check=False).returncode


if __name__ == "__main__":
    sys.exit(main())
