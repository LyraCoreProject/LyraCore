#!/usr/bin/env python3
import argparse
import os
from pathlib import Path
import subprocess
import sys
import tempfile


def main():
    parser = argparse.ArgumentParser(prog="./conformance/run")
    parser.add_argument("scenario")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    root = Path(__file__).resolve().parent.parent
    scratch = Path(os.environ.get(
        "LYRACORE_CONFORMANCE_SCRATCH",
        Path.home() / ".cache/lyracore-scratch/conformance-run",
    ))
    scratch.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="tier1-", dir=scratch) as directory:
        result = Path(directory) / "result.json"
        environment = os.environ.copy()
        environment["TMPDIR"] = str(scratch)
        environment["LYRACORE_CONFORMANCE_RESULT"] = str(result)
        test = subprocess.run(
            ["cargo", "test", "--quiet", "--locked", "-p", "lyracore-module",
             "--test", "native_conformance",
             f"tier1::{args.scenario}_matches_its_golden_trace", "--",
             "--ignored", "--exact", "--test-threads=1"],
            cwd=root, env=environment, capture_output=True, text=True, check=False,
        )
        if not result.is_file():
            sys.stderr.write(test.stdout + test.stderr)
            sys.stderr.write(f"no tier 1 result for {args.scenario}\n")
            return test.returncode or 1

        command = ["cargo", "run", "--quiet", "--locked", "-p", "lyracore-conformance",
                   "--example", "run", "--", args.scenario]
        if args.json:
            command.append("--json")
        rendered = subprocess.run(command, cwd=root, env=environment, check=False)
        if test.returncode and not rendered.returncode:
            sys.stderr.write(test.stdout + test.stderr)
        return rendered.returncode or test.returncode


if __name__ == "__main__":
    sys.exit(main())
