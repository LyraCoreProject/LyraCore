SETUP_FAILURE_EXIT = 2
DEFAULT_TIMEOUT_SECONDS = 3600
STOP_GRACE_SECONDS = 10
LIB_KINDS = {"lib", "rlib", "cdylib", "dylib", "staticlib", "proc-macro"}
TEST_SUMMARY = re.compile(r"^test result: \w+\. (\d+) passed; (\d+) failed;", re.MULTILINE)
COMPILE_ERROR = re.compile(r"^error: could not compile ", re.MULTILINE)
SPACETIME_VERSION = re.compile(r"spacetimedb tool version ([^;\s]+)")


class SetupFailure(Exception):
    pass


def stop_group(process):
    """Stop every process left in `process`'s group, including orphaned standalones."""
    for stop in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(process.pid, stop)
        except ProcessLookupError:
            break
        deadline = time.monotonic() + STOP_GRACE_SECONDS
        while time.monotonic() < deadline:
            process.poll()
            try:
                os.killpg(process.pid, 0)
            except ProcessLookupError:
                return
            time.sleep(0.1)
    process.wait()


def run_bounded(command, cwd, env, timeout, log_dir):
    """Return `(returncode, output)`; returncode is None when `timeout` seconds pass first."""
    with tempfile.TemporaryFile(dir=log_dir) as output:
        try:
            process = subprocess.Popen(command, cwd=cwd, env=env, stdin=subprocess.DEVNULL,
                                       stdout=output, stderr=subprocess.STDOUT,
                                       start_new_session=True)
        except OSError as error:
            raise SetupFailure(f"could not start {command[0]}: {error}") from error
        try:
            returncode = process.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            returncode = None
        finally:
            stop_group(process)
        output.seek(0)
        return returncode, output.read().decode(errors="replace")


def git(root, *args):
    try:
        return subprocess.run(["git", *args], cwd=root, capture_output=True, text=True,
                              check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError) as error:
        detail = getattr(error, "stderr", "") or str(error)
        raise SetupFailure(f"git {' '.join(args)} failed: {detail.strip()}") from error


def changed_files(root, merge_base, head):
    """Return `{path: present_at_head}` for every file the pull request changes."""
    listing = git(root, "diff", "--name-status", "--no-renames", "-z", merge_base, head)
    fields = [field for field in listing.split("\0") if field]
    return {path: status != "D" for status, path in zip(fields[::2], fields[1::2])}


def tail(output, lines=40):
    return "\n".join(output.strip().splitlines()[-lines:])


def cargo_test_command(selector, *, compile_only):
    command = ["cargo", "test", "--locked", "-p", selector["package"]]
    if selector["target"] == evidence.LIB_TARGET:
        command.append("--lib")
    else:
        command += ["--test", selector["target"]]
    if selector["features"]:
        command += ["--features", ",".join(selector["features"])]
    if compile_only:
        return command + ["--no-run"]
    return command + ["--", "--exact", selector["name"], "--include-ignored", "--test-threads=1"]


def test_outcome(returncode, output):
    if returncode is None:
        return "timed_out"
    summary = TEST_SUMMARY.search(output)
    if summary:
        passed, failed = int(summary[1]), int(summary[2])
        if failed:
            return "failed"
        return "passed" if passed else "not_found"
    if returncode and re.search(r"^running 1 test$", output, re.MULTILINE):
        return "failed"
    raise SetupFailure(f"cargo test produced no test result:\n{tail(output)}")


def run_test(selector, cwd, env, timeout, log_dir):
    returncode, output = run_bounded(cargo_test_command(selector, compile_only=True), cwd, env,
                                     timeout, log_dir)
    if returncode is None:
        raise SetupFailure(f"building {selector['package']} timed out after {timeout} seconds")
    if returncode:
        if COMPILE_ERROR.search(output):
            return "did_not_compile"
        raise SetupFailure(f"cargo could not build {selector['package']}:\n{tail(output)}")
    return test_outcome(*run_bounded(cargo_test_command(selector, compile_only=False), cwd, env,
                                     timeout, log_dir))


def defining_source(selector, package_dir, changes, root):
    """Return a changed non-test file in the package that defines the test's function, if any."""
    leaf = selector["name"].rsplit("::", 1)[-1]
    definition = re.compile(rf"\bfn\s+{re.escape(leaf)}\s*[<(]")
    prefix = "" if package_dir == "." else package_dir.rstrip("/") + "/"
    for path, present in sorted(changes.items()):
        if (present and path.endswith(".rs") and path.startswith(prefix)
                and not evidence.is_test_file(path)
                and definition.search((root / path).read_text(errors="replace"))):
            return path
    return None


OUTCOME_PHRASES = {
    "passed": "passes",
    "failed": "fails",
    "did_not_compile": "does not compile",
    "not_found": "is not found",
    "timed_out": "times out",
}


def not_shown_reason(name, base, head, source):
    if source is not None:
        return (f"{name} is defined in {source}, which this pull request changes outside its "
                "test files")
    if head != "passed":
        return f"{name} {OUTCOME_PHRASES[head]} at the head"
    return (f"{name} {OUTCOME_PHRASES[base]} at the merge-base with this pull request's test "
            "files applied")


def scenario_digest(report):
    """Return the signature digest of a `./conformance/run --result` report for one scenario."""
    [entry] = report["scenarios"]
    differences = entry["comparison"]["differences"]
    signatures = {
        classification: [{key: difference.get(key) for key in evidence.SIGNATURE_FIELDS}
                         for difference in differences
                         if difference["classification"] == classification]
        for classification in ("rule", "data")
    }
    return evidence.signature_digest(entry["scenario_sha256"], report["harness_revision"],
                                     signatures["rule"], signatures["data"])


def run_scenario(root, scenario, timeout, log_dir):
    with tempfile.TemporaryDirectory(dir=log_dir) as directory:
        result = Path(directory) / "result.json"
        command = [str(root / "conformance/run"), scenario, "--json", "--result", str(result)]
        returncode, output = run_bounded(command, root, os.environ.copy(), timeout, log_dir)
        if returncode in (0, 1):
            try:
                digest = scenario_digest(json.loads(result.read_text()))
            except (OSError, ValueError, KeyError, TypeError) as error:
                raise SetupFailure(f"{scenario}: unreadable run result: {error}") from error
        elif returncode in (None, 2):
            digest = None
        else:
            raise SetupFailure(
                f"{scenario}: ./conformance/run exited {returncode}:\n{tail(output)}")
    return {"id": scenario, "exit_code": returncode, "signature_digest": digest}


def workspace_packages(root):
    command = ["cargo", "metadata", "--locked", "--format-version", "1", "--no-deps"]
    try:
        metadata = subprocess.run(command, cwd=root, capture_output=True, text=True, check=True)
    except (OSError, subprocess.CalledProcessError) as error:
        raise SetupFailure(f"cargo metadata failed: {getattr(error, 'stderr', error)}") from error
    return json.loads(metadata.stdout)


def package_dir(metadata, root, selector):
    """Return the selected package's repo-relative directory after checking its target exists."""
    for package in metadata["packages"]:
        if package["name"] != selector["package"]:
            continue
        for target in package["targets"]:
            kinds = set(target["kind"])
            if (kinds & LIB_KINDS if selector["target"] == evidence.LIB_TARGET
                    else kinds == {"test"} and target["name"] == selector["target"]):
                manifest = Path(package["manifest_path"]).resolve()
                return manifest.parent.relative_to(root).as_posix()
        raise SetupFailure(f"{selector['package']} has no {selector['target']} test target")
    raise SetupFailure(f"{selector['package']} is not a workspace package")


class BaseCheckout:
    """The persistent merge-base worktree and target directory for one repository."""

    def __init__(self, root):
        common = git(root, "rev-parse", "--path-format=absolute", "--git-common-dir")
        self.root = root
        self.common = common
        self.directory = scratch("evidence", "LYRACORE_EVIDENCE_SCRATCH") / hashlib.sha256(
            common.encode()).hexdigest()[:16]
        self.checkout = self.directory / "checkout"
        self.target = self.directory / "target"
        self.logs = self.directory / "logs"

    def lock(self):
        self.logs.mkdir(parents=True, exist_ok=True)
        handle = (self.directory / "lock").open("w")
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            handle.close()
            raise SetupFailure("another ./conformance/evidence run uses this repository") from error
        return handle

    def prepare(self, merge_base, head, changes, head_target):
        if not self.target.exists():
            # A new checkout's sources postdate every cloned artifact, so workspace crates rebuild.
            self._remove_checkout()
            self._seed_target(head_target)
        if self.checkout.exists():
            if git(self.checkout, "rev-parse", "--path-format=absolute",
                   "--git-common-dir") != self.common:
                raise SetupFailure(f"{self.checkout} belongs to another repository; delete it")
            git(self.checkout, "reset", "--hard", "--quiet")
            git(self.checkout, "clean", "-ffdxq")
            git(self.checkout, "checkout", "--detach", "--quiet", "--force", merge_base)
        else:
            git(self.root, "worktree", "add", "--force", "--detach", "--quiet",
                str(self.checkout), merge_base)
        present = sorted(path for path, exists in changes.items()
                         if exists and evidence.is_test_file(path))
        if present:
            git(self.checkout, "checkout", head, "--", *present)
        for path, exists in changes.items():
            if not exists and evidence.is_test_file(path):
                (self.checkout / path).unlink(missing_ok=True)

    def _remove_checkout(self):
        if self.checkout.exists():
            git(self.root, "worktree", "remove", "--force", str(self.checkout))

    def _seed_target(self, head_target):
        if head_target is None or not head_target.is_dir():
            return
        partial = self.directory / "target.partial"
        shutil.rmtree(partial, ignore_errors=True)
        clone = ["cp", "-a", "-c"] if sys.platform == "darwin" else ["cp", "-a", "--reflink=always"]
        copied = subprocess.run([*clone, str(head_target), str(partial)], capture_output=True,
                                check=False)
        if copied.returncode:
            shutil.rmtree(partial, ignore_errors=True)
            sys.stderr.write("evidence: this filesystem cannot clone the head target directory; "
                             "the merge-base build starts cold\n")
            return
        partial.replace(self.target)


def tool_versions(root):
    try:
        rustc = subprocess.run(["rustc", "--version"], cwd=root, capture_output=True, text=True,
                               check=True, timeout=120).stdout.strip()
    except (OSError, subprocess.SubprocessError) as error:
        raise SetupFailure(f"rustc --version failed: {error}") from error
    spacetime = None
    try:
        output = subprocess.run([os.environ.get("SPACETIME_BIN", "spacetime"), "--version"],
                                capture_output=True, text=True, check=False, timeout=10)
        match = SPACETIME_VERSION.search(output.stdout + output.stderr)
        spacetime = match[1] if match else None
    except (OSError, subprocess.SubprocessError):
        pass
    return {"rustc": rustc.removeprefix("rustc "), "spacetime": spacetime}


def current_platform():
    return {"os": platform.system().lower(), "arch": platform.machine().lower()}


def collect(root, args):
    if git(root, "status", "--porcelain"):
        raise SetupFailure("the working tree is dirty; commit or remove the changes first")
    head = git(root, "rev-parse", "HEAD")
    merge_base = git(root, "merge-base", "HEAD", args.base)
    unknown = sorted(set(args.scenario) - tier1_scenarios(root))
    if unknown:
        raise SetupFailure(f"no tier 1 test for scenarios {unknown}")
    features = sorted({feature for feature in (args.features or "").split(",") if feature})
    selectors = [{"package": package, "target": target, "name": name, "features": features}
                 for package, target, name in args.test]
    base_checkout = BaseCheckout(root)
    lock = base_checkout.lock()
    try:
        metadata = workspace_packages(root) if selectors else None
        changes = changed_files(root, merge_base, head)
        environment = os.environ.copy()
        tier1 = tier1_scratch()
        tier1.mkdir(parents=True, exist_ok=True)
        environment["TMPDIR"] = str(tier1)
        logs = base_checkout.logs
        sources, head_outcomes = [], []
        for selector in selectors:
            sources.append(defining_source(selector, package_dir(metadata, root, selector),
                                           changes, root))
            head_outcomes.append(run_test(selector, root, environment, args.timeout, logs))
            sys.stderr.write(f"evidence: {selector['name']} at the head: {head_outcomes[-1]}\n")
        base_outcomes = ["not_run"] * len(selectors)
        pending = [index for index, (source, outcome) in enumerate(zip(sources, head_outcomes))
                   if source is None and outcome == "passed"]
        if pending:
            base_checkout.prepare(merge_base, head, changes, Path(metadata["target_directory"]))
            base_environment = dict(environment, CARGO_TARGET_DIR=str(base_checkout.target))
            for index in pending:
                base_outcomes[index] = run_test(selectors[index], base_checkout.checkout,
                                                base_environment, args.timeout, logs)
                sys.stderr.write(f"evidence: {selectors[index]['name']} at the merge-base: "
                                 f"{base_outcomes[index]}\n")
        results = []
        for selector, source, base, head_outcome in zip(selectors, sources, base_outcomes,
                                                        head_outcomes):
            status = evidence.test_status(base, head_outcome)
            results.append({
                **selector,
                "status": status,
                "base": base,
                "head": head_outcome,
                "reason": None if status == "shown"
                else not_shown_reason(selector["name"], base, head_outcome, source),
            })
        scenarios = []
        for scenario in args.scenario:
            result = run_scenario(root, scenario, args.timeout, logs)
            sys.stderr.write(f"evidence: {scenario} exited {result['exit_code']}\n")
            scenarios.append(result)
    finally:
        lock.close()
    return evidence.validate({
        "schema_version": evidence.SCHEMA_VERSION,
        "merge_base": merge_base,
        "head": head,
        "tests": results,
        "scenarios": scenarios,
        "tools": tool_versions(root),
        "platform": current_platform(),
    })


def publish(root, number, document):
    try:
        view = subprocess.run(["gh", "pr", "view", str(number), "--json", "body,headRefOid"],
                              cwd=root, capture_output=True, text=True, check=True)
        pull_request = json.loads(view.stdout)
        if pull_request["headRefOid"] != document["head"]:
            raise SetupFailure(f"pull request #{number} head is {pull_request['headRefOid']}, "
                               f"not {document['head']}; push first")
        body = evidence.replace_section(pull_request["body"], document)
        subprocess.run(["gh", "pr", "edit", str(number), "--body-file", "-"], cwd=root,
                       input=body, capture_output=True, text=True, check=True)
    except (OSError, subprocess.CalledProcessError) as error:
        detail = getattr(error, "stderr", "") or str(error)
        raise SetupFailure(f"could not update pull request #{number}: {detail.strip()}") from error


def selector_part(pattern, label):
    def parse(value):
        if not pattern.fullmatch(value):
            raise argparse.ArgumentTypeError(f"invalid {label} {value!r}")
        return value
    return parse


def parse_args():
    parser = argparse.ArgumentParser(prog="./conformance/evidence")
    parser.add_argument("--test", nargs=3, action="append", default=[],
                        metavar=("PACKAGE", "TARGET", "NAME"),
                        help="TARGET is `lib` for unit tests or an integration test target name")
    parser.add_argument("--features",
                        type=selector_part(re.compile(r"[A-Za-z0-9_,-]+"), "features"),
                        help="comma-separated features for every --test")
    parser.add_argument("--scenario", action="append", default=[],
                        type=selector_part(evidence.SCENARIO, "scenario"))
    parser.add_argument("--base", default="origin/main")
    parser.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT_SECONDS)
    parser.add_argument("--pr", type=int)
    args = parser.parse_args()
    for package, target, name in args.test:
        for value, pattern, label in ((package, evidence.PACKAGE, "package"),
                                      (target, evidence.TARGET, "target"),
                                      (name, evidence.TEST_NAME, "test name")):
            if not pattern.fullmatch(value):
                parser.error(f"invalid {label} {value!r}")
    if not args.test and not args.scenario:
        parser.error("name at least one --test or --scenario")
    if (len(set(map(tuple, args.test))) != len(args.test)
            or len(set(args.scenario)) != len(args.scenario)):
        parser.error("name each --test and --scenario once")
    return args


def main():
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(128 + signal.SIGTERM))
    args = parse_args()
    root = Path(__file__).resolve().parent.parent
    try:
        document = collect(root, args)
        sys.stdout.write(evidence.render(document))
        sys.stdout.flush()
        if args.pr is not None:
            publish(root, args.pr, document)
    except SetupFailure as error:
        sys.stderr.write(f"setup_failed: {error}\n")
        return SETUP_FAILURE_EXIT
    proven = (all(test["status"] == "shown" for test in document["tests"])
              and all(scenario["exit_code"] == 0 for scenario in document["scenarios"]))
    return 0 if proven else 1


if __name__ == "__main__":
    sys.exit(main())
