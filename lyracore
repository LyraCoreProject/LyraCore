#!/bin/sh
set -eu

fail() {
    printf 'lyracore: %s\n' "$*" >&2
    exit 1
}

root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || fail "cannot resolve the project root"
pin=$root/.lyracore-cli-rev

[ -f "$pin" ] || fail "missing $pin"
IFS= read -r revision <"$pin" || fail "cannot read $pin"
case $revision in
    *[!0-9a-f]* | "") fail "$pin must hold one 40-character lowercase hex commit SHA" ;;
esac
[ "${#revision}" -eq 40 ] || fail "$pin must hold one 40-character lowercase hex commit SHA"

if ! command -v cargo >/dev/null 2>&1; then
    if [ -f "$HOME/.cargo/env" ] || [ -x "$HOME/.cargo/bin/cargo" ]; then
        fail "Rust is installed but not on this shell's PATH — run: . \"\$HOME/.cargo/env\" (or start a new shell)"
    fi
    fail "cargo is required — install Rust from https://rustup.rs/"
fi

# Publishing requires unique table field names after snake_case normalization.
case ${1-} in
    preflight | publish)
        cargo test --quiet -p lyracore-module module_tables_have_unique_published_column_names \
            || fail "table field names collide after snake_case normalization"
        ;;
esac

# cargo install serializes cache writes through its --root lock.
install_root=$root/.lyracore/cli/$revision
binary=$install_root/bin/lyracore

if [ ! -x "$binary" ]; then
    printf 'lyracore: preparing the CLI (first run — this takes a minute)...\n' >&2
    # Anonymous HTTPS lets cargo fetch the public CLI without credentials.
    cargo install \
        --quiet \
        --git https://github.com/LyraCoreProject/lyracore-cli.git \
        --rev "$revision" \
        --locked \
        --root "$install_root" \
        || fail "could not install CLI revision $revision"
fi

case ${1-} in
    editor)
        MELD_LYRACORE_SPELL_COMPILER=${MELD_LYRACORE_SPELL_COMPILER:-$root/native-host/editor-spells.py}
        export MELD_LYRACORE_SPELL_COMPILER
        ;;
esac

exec "$binary" "$@"
