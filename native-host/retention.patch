+    pub(crate) fn prune_before(&mut self, first_required: u64) -> io::Result<usize> {
+        let mut removed = 0;
+        while let Some(&offset) = self.tail.first() {
+            let next = self.tail.get(1).copied().unwrap_or(self.head.min_tx_offset());
+            if next > first_required {
+                break;
+            }
+            self.repo.remove_segment_durably(offset)?;
+            self.tail.remove(0);
+            removed += 1;
+        }
+        Ok(removed)
+    }
+}
