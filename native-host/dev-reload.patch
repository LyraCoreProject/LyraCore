+fn check_development_schema(old: &ModuleDef, new: &ModuleDef) -> Result<()> {
+    use spacetimedb_lib::db::raw_def::v10::RawModuleDefV10;
+
+    let encode = |definition: &ModuleDef| {
+        spacetimedb_sats::bsatn::to_vec(&RawModuleDefV10::from(definition.clone()))
+            .map_err(|error| AutoMigrateError::DevelopmentSchemaEncoding(error.to_string()))
+    };
+    if old.raw_module_def_version() != new.raw_module_def_version() || encode(old)? != encode(new)? {
+        return Err(AutoMigrateError::DevelopmentSchemaChange.into());
+    }
+    Ok(())
+}
